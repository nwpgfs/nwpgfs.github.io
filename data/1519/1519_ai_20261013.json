    "observation_period_only": true,
    "do_not_assume_pre_observation_holdings": true,
    "single_day_buy_not_equal_accumulation": true,
    "single_day_sell_not_equal_distribution": true,
    "price_action_must_validate_broker_behavior": true,
    "event_thresholds": {
      "normal_pct_of_5ma": 3,
      "important_pct_of_5ma": 5,
      "major_pct_of_5ma": 10,
      "extreme_pct_of_5ma": 20
    },
    "event_memory_days": {
      "normal": 2,
      "important": 5,
      "major": 7,
      "extreme": 10
    },
    "primary_broker_importance_metric": "pct_of_5ma_volume",
    "secondary_broker_importance_metric": "pct_of_today_volume"
  }
}